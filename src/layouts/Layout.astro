---
import type { CVData } from "../cv_data_types.ts";

import Header from "../components/Header.astro";
import Contact from "../components/side/Contact.astro";
import Language from "../components/side/Languages.astro";
import Experience from "../components/main/Experience.astro";
import Education from "../components/main/Education.astro";
import Projects from "../components/main/Projects.astro";
import Technologies from "../components/main/Technologies.astro";
import WebPresence from "../components/main/WebPresence.astro";
import SoftSkills from "../components/side/SoftSkills.astro";
import Interests from "../components/side/Interests.astro";

interface Props {
    cvData: CVData;
}

const {
    cvData: {
        person,
        contact,
        languages,
        experience,
        education,
        projects,
        technologies,
        webPresence,
        softSkills,
        interests,
    },
} = Astro.props;
---

<div class="cv-container">
    <Header cvPerson={person} />
    <div class="cv-content-grid-container">
        <div class="cv-content-side-container">
            <Contact cvContact={contact} />
            {languages.length != 0 && <Language languages={languages} />}
            {softSkills.length != 0 && <SoftSkills softSkills={softSkills} />}
            {interests.length != 0 && <Interests interests={interests} />}
        </div>
        <div class="cv-content-main-container">
            {experience.length != 0 && <Experience cvExperience={experience} />}
            {education.length != 0 && <Education cvEducation={education} />}
            {projects.length != 0 && <Projects cvProjects={projects} />}
            {technologies.length != 0 && (
                <Technologies cvTechnologies={technologies} />
            )}
            {webPresence.length != 0 && (
                <WebPresence cvWebPresence={webPresence} />
            )}
        </div>
    </div>
</div>

<style>
    .cv-container {
        width: 21cm;
        height: 29.7cm;
        box-sizing: border-box;

        display: flex;
        flex-direction: column;
    }

    .cv-content-grid-container {
        flex: 1;
        display: grid;
        grid-template-columns: 30% 70%;
        text-align: center;
        width: 100%;
        height: 100%;
    }

    .cv-content-side-container {
        display: block;
        height: 100%;
        font-size: 12px;

        box-sizing: border-box;
        padding: 20px;
    }

    .cv-content-main-container {
        padding: 20px;
    }
</style>
