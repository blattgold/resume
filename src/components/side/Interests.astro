---
import type { CVInterestEntry } from "../../cv_data_types";

interface Props {
    interests: CVInterestEntry[];
}

const { interests } = Astro.props;
---

<div>
    <h3>Interessen</h3>
    <ul class="cv-side-list">
        {interests.map(({ interest }) => (
            <li>{interest}</li>
        ))}
    </ul>
</div>
