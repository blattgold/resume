---
import type { CVContact } from "../../cv_data_types.ts";

interface Props {
    cvContact: CVContact;
}

const {
    cvContact: { email, phone, location, website, github },
} = Astro.props;
---

<div>
    <h3>Kontakt</h3>
    <table style="cv-side-table">
        {email && (
            <tr>
                <td class="cv-side-table-l">Email</td>
                <td class="cv-side-table-r">{email}</td>
            </tr>
        )}
        {phone && (
            <tr>
                <td class="cv-side-table-l">Telefon</td>
                <td class="cv-side-table-r">{phone}</td>
            </tr>
        )}
        {location && (
            <tr>
                <td class="cv-side-table-l">Ort</td>
                <td class="cv-side-table-r">{location}</td>
            </tr>
        )}
        {website && (
            <tr>
                <td class="cv-side-table-l">Webseite</td>
                <td class="cv-side-table-r">
                    <a href={website.url}>{website.text}</a>
                </td>
            </tr>
        )}
        {github && (
            <tr>
                <td class="cv-side-table-l">Github</td>
                <td class="cv-side-table-r">
                    <a href={github.url}>{github.text}</a>
                </td>
            </tr>
        )}
    </table>
</div>
