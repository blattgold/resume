---
import type { CVLanguageEntry } from "../../cv_data_types";

interface Props {
    languages: CVLanguageEntry[];
}

const { languages } = Astro.props;
---

<div>
    <h3>Sprachen</h3>
    <table class="cv-side-table">
        {languages.map((language) => (
            <tr>
                <td class="cv-side-table-l">{language.language}</td>
                <td class="cv-side-table-r">{language.proficiency}</td>
            </tr>
        ))}
    </table>
</div>
