---
import type { CVSoftSkillsEntry } from "../../cv_data_types";

interface Props {
    softSkills: CVSoftSkillsEntry[];
}

const { softSkills } = Astro.props;
---

<div class="cv-side-soft-skills cv-side">
    <h3>Soft Skills</h3>
    <ul class="cv-soft-skills-list">
        {softSkills.map(({ skill }) => (
            <li>{skill}</li>
        ))}
    </ul>
</div>
