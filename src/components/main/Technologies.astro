---
import type { CVTechnologyEntry } from "../../cv_data_types.ts";

// invariant: Component must only be constructed if list len > 0
interface Props {
    cvTechnologies: CVTechnologyEntry[];
}

const { cvTechnologies } = Astro.props;
---

<div class="cv-main-technologies cv-main">
    <h3>Technologien</h3>
    <table class="cv-main-table">
        {cvTechnologies.map(({ category, entries }) => (
            <tr>
                <td class="cv-main-table-l">{category}</td>
                <td class="cv-main-table-r">{entries.join(", ")}</td>
            </tr>
        ))}
    </table>
</div>
