---
import type { CVWebPresenceEntry } from "../../cv_data_types.ts";

// invariant: Component must only be constructed if list len > 0
interface Props {
    cvWebPresence: CVWebPresenceEntry[];
}

const { cvWebPresence } = Astro.props;
---

<div class="cv-main-web-presence cv-main">
    <h3>Web Presenz</h3>
    <table class="cv-main-table">
        {cvWebPresence.map(({ title, url }) => (
            <tr>
                <td class="cv-main-table-l">{title}</td>
                <td class="cv-main-table-r">{url}</td>
            </tr>
        ))}
    </table>
</div>
