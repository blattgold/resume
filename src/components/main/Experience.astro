---
import type { CVExperienceEntry } from "../../cv_data_types.ts";

// invariant: Component must only be constructed if list len > 0
interface Props {
    cvExperience: CVExperienceEntry[];
}

const { cvExperience } = Astro.props;
---

<div>
    <h3>Berufserfahrung</h3>
    <table class="cv-main-table">
        {cvExperience.map(({ date, description }) => (
            <tr>
                <td class="cv-main-table-l">{date}</td>
                <td class="cv-main-table-r">{description}</td>
            </tr>
        ))}
    </table>
</div>
