---
import type { CVProjectEntry } from "../../cv_data_types.ts";

// invariant: Component must only be constructed if list len > 0
interface Props {
    cvProjects: CVProjectEntry[];
}

const { cvProjects } = Astro.props;
---

<div class="cv-main-projects cv-main">
    <h3>Projekte</h3>
    <table class="cv-main-table">
        {cvProjects.map(({ name, description }) => (
            <tr>
                <td class="cv-main-table-l">{name}</td>
                <td class="cv-main-table-r">{description}</td>
            </tr>
        ))}
    </table>
</div>
