---
import type { CVEducationEntry } from "../../cv_data_types.ts";

// invariant: Component must only be constructed if list len > 0
interface Props {
    cvEducation: CVEducationEntry[];
}

const { cvEducation } = Astro.props;
---

<div class="cv-main-experience cv-main">
    <h3>Ausbildung & Qualifikationen</h3>
    <table class="cv-main-table">
        {cvEducation.map(({ date, description }) => (
            <tr>
                <td class="cv-main-table-l">{date}</td>
                <td class="cv-main-table-r">{description}</td>
            </tr>
        ))}
    </table>
</div>
