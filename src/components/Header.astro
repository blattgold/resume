---
import type { CVPerson } from "../cv_data_types";

interface Props {
    cvPerson: CVPerson;
}

const {
    cvPerson: { name, title, subtitle },
} = Astro.props;
---

<div class="cv-header">
    <table class="cv-header-table">
        <tr>
            <td class="cv-header-name">{name}</td>
            <td class="cv-header-title">{title}</td>
        </tr>
        <tr>
            <td></td>
            <td>{subtitle}</td>
        </tr>
    </table>
</div>

<style>
    .cv-header {
        text-align: center;
        display: block;
        justify-content: space-around;
        width: 100%;
        padding: 20px;
    }

    .cv-header-table .cv-header-name {
        display: inline-block;
        font-size: 35px;
        padding-right: 100px;
        width: 100%;
        text-align: left;
    }

    .cv-header-title {
        font-size: 35px;
    }

    .cv-header-name-container {
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
    }
</style>
