---
import type { CVPerson } from "../cv_data_types";

interface Props {
    cvPerson: CVPerson;
}

const {
    cvPerson: { name, title, subtitle },
} = Astro.props;
---

<div class="cv-header">
    <div class="cv-header-name-container">
        <h2 class="cv-header-name">{name}</h2>
    </div>
    <div>
        <h2 class="cv-header-title">{title}</h2>
        <h3 class="cv-header-subtitle">{subtitle}</h3>
    </div>
</div>

<style>
    .cv-header {
        text-align: center;
        display: flex;
        justify-content: space-around;
        background-color: lightgray;
    }

    .cv-header-name {
        display: inline-block;
        vertical-align: middle;
        line-height: normal;
        font-size: 35px;
    }

    .cv-header-name-container {
        display: flex;
        justify-content: center;
        align-items: center;
        text-align: center;
    }
</style>
