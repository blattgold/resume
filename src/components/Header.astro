---
import type { CVPerson } from "../cv_data_types";

interface Props {
    cvPerson: CVPerson;
}

const {
    cvPerson: { name, title, subtitle },
} = Astro.props;
---

<div class="cv-header">
    <table class="cv-header-table">
        <tr>
            <td class="cv-header-name">{name}</td>
            <td class="cv-header-title">{title}</td>
        </tr>
        <tr>
            <td></td>
            <td>{subtitle}</td>
        </tr>
    </table>
</div>
