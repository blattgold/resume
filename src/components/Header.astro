---
import type { CVPerson } from "../cv_data_types";

interface Props {
    cvPerson: CVPerson;
}

const {
    cvPerson: { name, title, subtitle },
} = Astro.props;
---

<div class="cv-header">
    <h2>{name}</h2>
    <h2>{title}</h2>
</div>

<style>
    .cv-header {
        text-align: center;
        display: flex;
        justify-content: space-around;
        border-color: black;
        border-style: solid;
    }
</style>
