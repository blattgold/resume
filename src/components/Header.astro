---
interface Props {
    name: string;
    title: string;
}

const { name, title } = Astro.props;
---

<div class="cv-header">
    <h2>{name}</h2>
    <h2>{title}</h2>
</div>

<style>
    .cv-header {
        text-align: center;
        display: flex;
        justify-content: space-around;
        border-color: black;
        border-style: solid;
    }
</style>
